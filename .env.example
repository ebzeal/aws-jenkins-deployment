# Copy this file to `.env` (or `.env.local`) and fill in real values.
# The `.env` file itself is gitignored and must never be committed.

# --- Frontend (build-time, read by Create React App) ---
# Base URL of the backend API. Leave empty (unset) for production so the
# frontend uses same-origin requests (ALB routes /api/* to the backend).
REACT_APP_API_BASE_URL=http://localhost:8080

# --- Backend (runtime environment variables) ---
PORT=8080
HOST=0.0.0.0
NODE_ENV=production
# Comma-separated list of origins allowed to call the API (CORS).
CORS_ORIGIN=http://localhost:3000

# --- AWS (only needed for local CLI/Terraform runs; Jenkins uses an IAM role) ---
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
